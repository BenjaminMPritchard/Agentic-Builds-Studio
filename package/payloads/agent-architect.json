{
  "name": "Architect",
  "title": "architect",
  "role": "engineer",
  "reportsTo": null,
  "adapterType": "claude_local",
  "adapterConfig": {
    "engine": "auto",
    "dangerouslySkipPermissions": true,
    "env": {
      "CLAUDE_CODE_OAUTH_TOKEN": {
        "type": "secret_ref",
        "secretId": "<claude-oauth>",
        "version": "latest"
      },
      "GH_TOKEN": {
        "type": "secret_ref",
        "secretId": "<gh-studio-ops-internal>",
        "version": "latest"
      },
      "GH_TOKEN_SITE_READ": {
        "type": "secret_ref",
        "secretId": "<gh-studio-ops-external>",
        "version": "latest"
      }
    },
    "model": "claude-opus-5-5",
    "maxTurnsPerRun": 150,
    "timeoutSec": 7200,
    "extraArgs": [
      "--effort",
      "xhigh",
      "--settings",
      "/srv/studio/claude/architect.json"
    ],
    "cwd": "/srv/studio/work/architect"
  },
  "runtimeConfig": {
    "heartbeat": {
      "enabled": false,
      "intervalSec": 0,
      "cooldownSec": 120,
      "maxConcurrentRuns": 1,
      "wakeOnDemand": {
        "enabled": true
      }
    }
  },
  "permissions": {
    "canCreateAgents": false
  },
  "budgetMonthlyCents": 3000,
  "instructions": {
    "mode": "external",
    "rootPath": "/srv/studio/company/agents/architect"
  },
  "desiredSkills": [
    "studio-house-rules",
    "architect-review"
  ],
  "_note": "Or claude-fable-5-1 if the plan has it in Claude Code (guide \u00a710.9). Effort field left unset; --effort xhigh via extraArgs."
}
