{
  "name": "Director",
  "title": "director",
  "role": "ceo",
  "reportsTo": null,
  "adapterType": "claude_local",
  "adapterConfig": {
    "engine": "auto",
    "dangerouslySkipPermissions": true,
    "env": {
      "CLAUDE_CODE_OAUTH_TOKEN": {
        "type": "secret_ref",
        "secretId": "<claude-oauth>",
        "version": "latest"
      },
      "GH_TOKEN": {
        "type": "secret_ref",
        "secretId": "<gh-studio-coord>",
        "version": "latest"
      }
    },
    "model": "claude-opus-5-5",
    "maxTurnsPerRun": 40,
    "timeoutSec": 1200,
    "extraArgs": [
      "--settings",
      "/srv/studio/claude/director.json"
    ],
    "effort": "medium",
    "cwd": "/srv/studio/work/director"
  },
  "runtimeConfig": {
    "heartbeat": {
      "enabled": false,
      "intervalSec": 0,
      "cooldownSec": 120,
      "maxConcurrentRuns": 1,
      "wakeOnDemand": {
        "enabled": true
      }
    }
  },
  "permissions": {
    "canCreateAgents": false
  },
  "budgetMonthlyCents": 8000,
  "instructions": {
    "mode": "external",
    "rootPath": "/srv/studio/company/agents/director"
  },
  "desiredSkills": [
    "studio-house-rules",
    "task-packet",
    "project-bootstrap",
    "review-gate",
    "qwen-job"
  ],
  "_note": "Never create through the UI wizard's managed AI connection: Paperclip then refuses extraArgs and env overrides (error ai_connection_incompatible) and the connection cannot be removed, only the agent recreated."
}
