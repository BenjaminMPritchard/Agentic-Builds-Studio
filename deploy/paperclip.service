# System unit that runs Paperclip as the `paperclip` user (the user manager route doesn't work here).
# Install (as you):
#   sudo cp deploy/paperclip.service /etc/systemd/system/paperclip.service
#   sudo pkill -u paperclip -f paperclipai     # stop the hand-started nohup copy first
#   sudo systemctl daemon-reload && sudo systemctl enable --now paperclip
#   systemctl status paperclip; curl -s -o /dev/null -w "%{http_code}\n" localhost:3100
# Logs: journalctl -u paperclip -f
[Unit]
Description=Paperclip control plane (Studio)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=paperclip
Group=paperclip
Environment=HOME=/home/paperclip
Environment=PATH=/home/paperclip/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/paperclip
# Pinned (2026-11-03) to the installed copy of 2026.1023.0 that npx made on 2026-11-01. Unpinned, every
# restart ran the newest npm release: on 2026-11-01 that applied 28 migrations unreviewed and widened the
# operator role. `npx paperclipai@2026.1023.0` is not a pin either: it resolved a fresh dependency tree whose
# embedded Postgres needs libicui18n.so.60 (this host has ICU 78), and Paperclip did not start.
# Upgrade deliberately: read the release notes, back up the database, install the new version into its own
# directory, check its embedded Postgres starts, point this line at it, reinstall the unit, check /api/health.
ExecStart=/home/paperclip/.npm/_npx/43414d9b790239bb/node_modules/.bin/paperclipai run
# After each start: keep the Studio Clerk to tasks:assign (lib/clerk_grants.py). "-": a failure is logged and
# never stops Paperclip. It waits up to 240s for health, so the start timeout allows for that and npx.
ExecStartPost=-/srv/studio/company/bin/paperclip-trim-grants
TimeoutStartSec=420
Restart=on-failure
RestartSec=10
# Loopback only (local_trusted). Reach it over Tailscale; never expose 3100 to the internet.

[Install]
WantedBy=multi-user.target
