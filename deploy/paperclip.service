# System unit that runs Paperclip as the `paperclip` user (the user manager route doesn't work here).
# Install (as you):
#   sudo cp deploy/paperclip.service /etc/systemd/system/paperclip.service
#   sudo pkill -u paperclip -f paperclipai     # stop the hand-started nohup copy first
#   sudo systemctl daemon-reload && sudo systemctl enable --now paperclip
#   systemctl status paperclip; curl -s -o /dev/null -w "%{http_code}\n" localhost:3100
# Logs: journalctl -u paperclip -f
[Unit]
Description=Paperclip control plane (Studio)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=paperclip
Group=paperclip
Environment=HOME=/home/paperclip
Environment=PATH=/home/paperclip/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/paperclip
ExecStart=/usr/bin/env npx --yes paperclipai run
Restart=on-failure
RestartSec=10
# Loopback only (local_trusted). Reach it over Tailscale; never expose 3100 to the internet.

[Install]
WantedBy=multi-user.target
