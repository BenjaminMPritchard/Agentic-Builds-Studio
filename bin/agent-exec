#!/usr/bin/env bash
# Runs the agent CLI as the confined `studio-agent` user. Set it as a claude_local agent's
# adapterConfig.command (see playbook/m2-boundaries.md step 4 and playbook/github-identities.md).
#
# paperclip -> studio-agent drops privilege, so the adapter's whole environment and working
# directory pass through. studio-agent cannot read Paperclip's data, its process environment or
# /etc/paperclip.env. Guard and the deny rules travel in the per-role --settings file, not in
# ~/.claude, so they still apply. setpriv kills the CLI if this wrapper dies, because paperclip
# cannot signal another user's processes directly. Files Paperclip writes under its own home for the CLI are
# staged where studio-agent can read them (bin/agent-stage).
#
# GitHub: when the agents' App is configured (/etc/studio/agents-app.json, readable by paperclip only),
# the run gets that App's one-hour token for its account instead of any inherited personal token, so
# agents act on GitHub as the App, which cannot merge. If the token cannot be made, the run does not start.
# The run also gets a grant (lib/agent_grant.py) naming its account for 8 hours: agent-bin/gh and
# bin/agent-git-credential renew the token through it, so `gh` and `git push` work in runs over an hour.
# Usage caps: see the studio-quota step below; a run that would break a cap does not start (exit 5, or 6 with no reading).
# sudo replaces PATH with secure_path, so PATH is passed on the sudo command line (the rule allows SETENV).
set -euo pipefail
# Paperclip writes the prompt to the CLI's stdin after starting this wrapper. A wrapper that refuses and exits first
# leaves that write going into a closed pipe, and Paperclip 2026.916.1 does not handle the EPIPE: the whole server
# exits (2026-10-02, a Director run refused in the runtime folder). So a refusal reads the prompt before exiting.
# After `exec` the CLI owns stdin and this trap is gone.
trap 'rc=$?; if [ "$rc" -ne 0 ] && [ ! -t 0 ]; then timeout 10 cat >/dev/null 2>&1 || true; fi; exit "$rc"' EXIT
AGENT_USER="${STUDIO_AGENT_USER:-studio-agent}"
PROVIDER="${STUDIO_AGENT_PROVIDER:-claude}"
APP_CONFIG="${STUDIO_AGENTS_APP_CONFIG:-/etc/studio/agents-app.json}"
OWNER="${STUDIO_AGENT_GITHUB_OWNER:-Agentic-Builds-Studio-Client-Pages}"
HERE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
SETENV=()
# One package cache for every agent and run (deploy/agent-cache-setup.sh makes it), so uv and npm do not download
# the same packages again on each run. Not there: each tool's own default, as before.
CACHE="${STUDIO_AGENT_CACHE:-/srv/studio/data/agent-cache}"
[ -d "$CACHE" ] || CACHE=""
# The runtime checkout is not a workspace: a task in a project whose folder is /srv/studio/company starts there,
# and an agent working in it would be working on the live Studio. Studio tasks have no project.
RUNTIME="${STUDIO_RUNTIME_DIR:-/srv/studio/company}"
case "$(pwd -P)/" in "$RUNTIME"/*|"$RUNTIME"-*/*) echo "agent-exec: refusing to run in $(pwd -P), the Studio runtime; take the task out of its project so it runs in the agent's own folder" >&2; exit 2 ;; esac
refuse() { echo "agent-exec: $1" >&2; exit 2; }
case "$PROVIDER" in
  claude)
    CLI="${STUDIO_AGENT_CLI:-/home/studio-agent/.local/bin/claude}"
    case " $* " in *" --settings "*) ;; *) refuse "refusing to run without --settings (Guard would not load)" ;; esac ;;
  codex)
    # Codex (codex_local adapter, engine "cli"). Guard and the Constitution's limits live in the root-owned
    # /etc/codex/requirements.toml as managed settings the agent cannot override: Guard as the only hooks,
    # sub-agents off, no full-access sandbox. Without them, no run.
    CLI="${STUDIO_AGENT_CODEX_CLI:-/usr/local/bin/codex}"
    REQ="${STUDIO_CODEX_REQUIREMENTS:-/etc/codex/requirements.toml}"
    for want in '^allow_managed_hooks_only = true' '^command = "/srv/studio/bin/guard"' '^multi_agent = false' \
                '^multi_agent_v2 = false' '^allowed_sandbox_modes = \["read-only", "workspace-write"\]'; do
      grep -qE "$want" "$REQ" 2>/dev/null || refuse "$REQ does not pin the Studio's Codex limits ($want); not starting"
    done
    case " $* " in *" --dangerously-bypass-"*) refuse "refusing a Codex bypass flag" ;; esac
    # Paperclip's managed Codex home is under its own home, which studio-agent cannot read: the agents share
    # the Studio's Codex home (its ChatGPT sign-in). No API key: subscription only.
    export CODEX_HOME="${STUDIO_CODEX_HOME:-/srv/studio/data/codex-home}"
    # Paperclip writes config.toml (and skills) there before each run with owner-only modes, which studio-agent
    # cannot read. Open paperclip's own files to the agent group; studio-agent's auth.json is not ours to touch.
    if [ -d "$CODEX_HOME" ]; then
      find "$CODEX_HOME" -user "$(id -un)" \( -type d -exec chmod g+rwxs {} + -o -type f -exec chmod g+rw {} + \) 2>/dev/null || true
      # Paperclip authenticates its MCP gateways with `headers = {...}`; Codex 0.156 reads only `http_headers` and
      # ignores the rest, so the agent had no Paperclip tools (2026-09-30, AGE-19). Rename it in the MCP tables.
      if [ -f "$CODEX_HOME/config.toml" ] && [ -O "$CODEX_HOME/config.toml" ]; then
        FIXED="$(awk '/^\[/ { mcp = ($0 ~ /^\[mcp_servers\./) } mcp && /^headers = / { sub(/^headers = /, "http_headers = ") } { print }' "$CODEX_HOME/config.toml" 2>/dev/null)" \
          && printf '%s\n' "$FIXED" > "$CODEX_HOME/config.toml"
      fi
    fi
    unset OPENAI_API_KEY OPENAI_BASE_URL
    # Codex's workspace-write sandbox mounts <root>/.git read-only under each writable root (and follows a
    # worktree's gitdir pointer to it), so a builder could edit files but never commit. A repository's .git named
    # as a writable root of its own is writable, so each writable_roots list given is extended in place with every
    # repository's .git found up to three levels below its roots (projects/<name>/repo/.git).
    # The shared package cache is outside every workspace, so it is added as a writable root as well (Codex's home
    # folder is read-only in the sandbox, which made uv fail with "Read-only file system").
    NEW=()
    for a in "$@"; do
      case "$a" in sandbox_workspace_write.writable_roots=*)
        LIST=()
        [ -n "$CACHE" ] && LIST+=("\"$CACHE\"")
        while IFS= read -r r; do
          LIST+=("\"$r\"")
          while IFS= read -r g; do LIST+=("\"$g\""); done < <(find "$r" -mindepth 1 -maxdepth 3 -name .git -type d -prune 2>/dev/null | sort)
        done < <(printf '%s\n' "${a#*=}" | grep -o '"[^"]*"' | tr -d '"')
        a="sandbox_workspace_write.writable_roots=[$(IFS=,; echo "${LIST[*]}")]" ;;
      esac
      NEW+=("$a")
    done
    set -- "${NEW[@]}" ;;
  *) refuse "unknown STUDIO_AGENT_PROVIDER '$PROVIDER'" ;;
esac
# gh reads its settings from GH_CONFIG_DIR, which may point into Paperclip's home (unreadable to studio-agent).
export GH_CONFIG_DIR="/home/$AGENT_USER/.config/gh"
if [ -n "$CACHE" ]; then
  export UV_CACHE_DIR="$CACHE/uv" npm_config_cache="$CACHE/npm" PIP_CACHE_DIR="$CACHE/pip"
fi
if [ -e "$APP_CONFIG" ]; then
  TOKEN="$("$HERE/agent-github-token" "$OWNER")" || { echo "agent-exec: no GitHub App token for $OWNER; not starting" >&2; exit 3; }
  GRANT="$("$HERE/agent-github-token" --new-grant "$OWNER")" || { echo "agent-exec: no GitHub grant for $OWNER; not starting" >&2; exit 3; }
  unset GITHUB_TOKEN
  export GH_TOKEN="$TOKEN" STUDIO_AGENT_TOKEN_ISSUED_AT="$(date +%s)" STUDIO_AGENT_GITHUB_GRANT="$GRANT"
  export GIT_CONFIG_COUNT=2
  export GIT_CONFIG_KEY_0="credential.https://github.com.helper" GIT_CONFIG_VALUE_0=""
  export GIT_CONFIG_KEY_1="credential.https://github.com.helper" GIT_CONFIG_VALUE_1="!$HERE/agent-git-credential"
  SETENV+=("PATH=$(realpath "$HERE/../agent-bin"):$PATH")
fi
# Paperclip writes the instructions, prompt bundle and MCP config under its own home, which studio-agent cannot
# read; stage copies it can (lib/agent_stage.py) and rewrite those arguments. No staging, no run.
STAGED="$(mktemp)"
"$HERE/agent-stage" "$@" > "$STAGED" || { rm -f "$STAGED"; echo "agent-exec: could not stage Paperclip's files for $AGENT_USER; not starting" >&2; exit 3; }
mapfile -d '' -t ARGS < "$STAGED"; rm -f "$STAGED"
# sudo reads VAR=value only before `--`; after it, `PATH=...` would be taken as the command and match no rule.
CMD=(sudo -n -E -H -u "$AGENT_USER")
if [ ${#SETENV[@]} -gt 0 ]; then CMD+=("${SETENV[@]}"); else CMD+=(--); fi
CMD+=(/usr/bin/setpriv --pdeathsig KILL -- "$CLI" "${ARGS[@]}")
# Usage caps (bin/studio-quota, policy/quota.json): reserve this run's estimated cost or do not start. A detached
# watcher releases the reservation once this process (which becomes sudo, then waits for the CLI) is gone, then
# removes this run's staged files. If the watcher is killed too, the next run's admission and staging do both.
QUOTA="${STUDIO_QUOTA:-$HERE/studio-quota}"
if [ "${STUDIO_AGENT_EXEC_DRY_RUN:-0}" != 1 ] || [ -n "${STUDIO_QUOTA:-}" ]; then
  QTOKEN="$("$QUOTA" admit --provider "$PROVIDER" --agent "${PAPERCLIP_AGENT_ID:-unknown}" --pid $$ --run "${PAPERCLIP_RUN_ID:-}")" || exit $?
  # Near a cap the watcher asks the run to wrap up by writing this file; Guard then allows only the steps that save
  # and hand over the work (bin/guard, wrap_up). The file is the watcher's, in a folder the agent can read only.
  export STUDIO_WRAP_UP="${STUDIO_AGENT_STAGE_DIR:-/srv/studio/data/agent-runs}/wrap-up-$$"
  rm -f "$STUDIO_WRAP_UP" 2>/dev/null || true  # a file left by an earlier process with the same pid
  # Codex rewrites its config.toml as studio-agent with mode 0600 (it records the project it ran in), and
  # Paperclip then cannot open it to write the next run's MCP settings: every later Codex run fails. Paperclip can
  # still remove the file (the folder is its own), and writes a fresh one on the next run; only Codex's project
  # trust entries are lost, which the Studio does not want kept anyway.
  setsid sh -c '"$0" release --provider "$4" --after-pid "$1" --wrap-up "$6" "$2"; "$3" --prune
    if [ -n "$5" ] && [ -e "$5/config.toml" ] && [ ! -r "$5/config.toml" ]; then rm -f "$5/config.toml"; fi' \
    "$QUOTA" $$ "$QTOKEN" "$HERE/agent-stage" "$PROVIDER" "${CODEX_HOME:-}" "$STUDIO_WRAP_UP" </dev/null >/dev/null 2>&1 &
fi
if [ "${STUDIO_AGENT_EXEC_DRY_RUN:-0}" = 1 ]; then
  printf '%q ' "${CMD[@]}"; echo
  echo "GH_CONFIG_DIR=$GH_CONFIG_DIR"
  echo "UV_CACHE_DIR=${UV_CACHE_DIR:-}"; echo "npm_config_cache=${npm_config_cache:-}"
  if [ -n "${GH_TOKEN:-}" ]; then echo "GH_TOKEN=${GH_TOKEN:0:8}..."; echo "GITHUB_TOKEN=${GITHUB_TOKEN:+set}"; fi
  if [ -n "${STUDIO_AGENT_GITHUB_GRANT:-}" ]; then echo "GRANT=$STUDIO_AGENT_GITHUB_GRANT"; echo "CREDENTIAL=$GIT_CONFIG_VALUE_1"; fi
  if [ "$PROVIDER" = codex ]; then echo "CODEX_HOME=$CODEX_HOME"; echo "OPENAI_API_KEY=${OPENAI_API_KEY:+set}"; fi
  exit 0
fi
exec "${CMD[@]}"
