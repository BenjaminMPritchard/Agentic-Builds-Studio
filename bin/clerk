#!/usr/bin/env python3
"""The Clerk's command. `clerk tick` (every 10 min), `clerk weekly`, `clerk report` (efficiency records).

Env: STUDIO_COMPANY_ID (required), STUDIO_DATA, STUDIO_DIRECTOR_ID, STUDIO_PRINCIPAL_ID,
STUDIO_RECORDER_ID, STUDIO_AUTODEPLOY=1 (pull+test+fast-forward /srv/studio/company from origin main; STUDIO_DEPLOY_REPO, STUDIO_INFRA_PROJECT_ID for skill rescans), CLERK_DRY_RUN=1 (report only: writes digests and logs, wakes no one).
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from lib.clerk import Clerk  # noqa: E402
from lib.paperclip import Paperclip, board_key  # noqa: E402

E = os.environ.get
# The Clerk acts as its own Paperclip service user (operator role) when this key exists: as an agent, Paperclip
# lets it change only its own tasks. The key file must be the running user's and mode 0600, or the Clerk stops.
CLERK_KEY = E("STUDIO_CLERK_KEY_FILE", "/srv/studio/data/clerk/board-key")


def client():
    if os.path.exists(CLERK_KEY):
        return Paperclip(key=board_key(CLERK_KEY), run_id=False)
    return Paperclip()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "tick"
    if not E("STUDIO_COMPANY_ID"):
        print("STUDIO_COMPANY_ID is not set", file=sys.stderr)
        return 1
    c = Clerk(client(), E("STUDIO_COMPANY_ID"), E("STUDIO_DATA", "/srv/studio/data"),
              dry_run=E("CLERK_DRY_RUN") == "1", director_id=E("STUDIO_DIRECTOR_ID"),
              principal_id=E("STUDIO_PRINCIPAL_ID"), recorder_id=E("STUDIO_RECORDER_ID"),
              deploy_repo=(E("STUDIO_DEPLOY_REPO", "/srv/studio/company") if E("STUDIO_AUTODEPLOY") == "1" else None),
              infra_project_id=E("STUDIO_INFRA_PROJECT_ID"))
    if cmd == "tick":
        c.tick()
    elif cmd == "weekly":
        print(c.weekly())
    elif cmd == "report":
        print(c.report())
    else:
        print("usage: clerk tick|weekly|report", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
