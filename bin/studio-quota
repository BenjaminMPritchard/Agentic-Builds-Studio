#!/usr/bin/env python3
"""Usage caps for agent runs (lib/quota.py). Called by agent-exec as paperclip, never by agents.

  studio-quota admit   --provider claude --agent ID --pid PID [--run RUN_ID]  # prints a run token; exit 5 refused, 6 no reading
  studio-quota release --provider claude TOKEN [--after-pid PID]  # waits until PID has exited (stopping it at a cap), then settles
  studio-quota status  --provider claude                        # JSON
  studio-quota correct --provider claude --window five_hour|week --points N --reason TEXT   # repair, logged
  studio-quota override --provider claude --window five_hour --points 100 --until 2026-10-02T08:00 --reason TEXT
                                                  # a temporary cap that ends by itself at --until (local time), logged

The reading is `claude -p /usage` (no model call) with paperclip's own claude.ai sign-in: the run's token and
any API key are removed, so the reading is always the subscription meter, never API usage. Codex has no reader yet, so Codex runs are refused until one is added.
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from lib import quota  # noqa: E402

ROOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
POLICY = os.environ.get("STUDIO_QUOTA_POLICY", os.path.join(ROOT, "policy", "quota.json"))
LEDGER_DIR = os.environ.get("STUDIO_QUOTA_DIR", "/srv/studio/data/quota")


def read_claude():
    cli = os.environ.get("STUDIO_QUOTA_CLAUDE_CLI", "claude")
    try:
        r = subprocess.run([cli, "-p", "/usage", "--tools", ""], capture_output=True, text=True, timeout=90,
                           cwd=LEDGER_DIR, stdin=subprocess.DEVNULL,
                           env={k: v for k, v in os.environ.items() if k not in DROP_ENV})
    except (OSError, subprocess.TimeoutExpired) as e:
        raise quota.QuotaError(f"could not run {cli} /usage: {e}")
    if r.returncode != 0:
        raise quota.QuotaError(f"{cli} /usage exited {r.returncode}: {(r.stderr or r.stdout).strip()[:200]}")
    return quota.parse_usage(r.stdout)


def read_codex():
    cli = os.environ.get("STUDIO_QUOTA_CODEX_CLI", "/usr/local/bin/codex")
    env = {k: v for k, v in os.environ.items() if k not in DROP_ENV}
    env["CODEX_HOME"] = os.environ.get("STUDIO_CODEX_HOME", "/srv/studio/data/codex-home")
    requests = [{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"clientInfo": {"name": "studio-quota", "version": "1"}}},
                {"jsonrpc": "2.0", "method": "initialized", "params": {}},
                {"jsonrpc": "2.0", "id": 2, "method": "account/rateLimits/read", "params": {}}]
    try:
        # The sign-in belongs to studio-agent (Codex keeps auth.json owner-only and rewrites it on every token
        # refresh), so the reader runs Codex as studio-agent through the same sudo rule the agents use.
        user = os.environ.get("STUDIO_QUOTA_CODEX_USER", "studio-agent")
        cmd = ["sudo", "-n", "-E", "-u", user, "/usr/bin/setpriv", "--pdeathsig", "KILL", "--", cli, "app-server"] \
            if user else [cli, "app-server"]
        proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True, env=env, cwd=LEDGER_DIR)
    except OSError as e:
        raise quota.QuotaError(f"could not run {cli} app-server: {e}")
    try:
        proc.stdin.write("".join(json.dumps(r) + "\n" for r in requests))
        proc.stdin.flush()
        deadline = time.time() + 60
        while time.time() < deadline:
            line = proc.stdout.readline()
            if not line:
                break
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get("id") == 2:
                if "error" in msg:
                    raise quota.QuotaError(f"Codex rate limits: {str(msg['error'])[:200]}")
                return quota.parse_codex(msg.get("result"))
        raise quota.QuotaError("Codex app-server gave no rate-limit answer")
    finally:
        proc.kill()
        proc.wait()


def load(provider):
    return quota.load_policy(POLICY, provider, os.path.join(LEDGER_DIR, f"override-{provider}.json"))


DROP_ENV = {"CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL",
            "OPENAI_API_KEY", "OPENAI_BASE_URL"}
READERS = {"claude": read_claude, "codex": read_codex}


def reading(provider):
    if provider not in READERS:
        raise quota.QuotaError(f"no usage reader for {provider}")
    return READERS[provider]()


def check_running(a, path, policy):
    """One check during a run: stop it (SIGTERM, logged) if studio use has reached a cap. True once stopped.
    The policy is read again each time, so an override set or ended during the run applies to it."""
    policy = load(a.provider)
    try:
        r = reading(a.provider)
    except quota.QuotaError:
        return False  # no reading: keep going; admission and release still read
    with quota.Ledger(path) as ledger:
        reasons = quota.over_cap(ledger, r, policy, quota.now())
    if not reasons:
        return False
    try:
        os.kill(a.after_pid, signal.SIGTERM)
    except OSError as e:
        reasons.append(f"could not stop it: {e}")
    fd = os.open(os.path.join(LEDGER_DIR, "stops.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(json.dumps({"t": quota.now(), "provider": a.provider, "pid": a.after_pid, "token": a.token,
                            "reasons": reasons}) + "\n")
    print(f"studio-quota: stopped run {a.after_pid}: " + "; ".join(reasons), file=sys.stderr)
    return True


def main(argv):
    ap = argparse.ArgumentParser(prog="studio-quota")
    ap.add_argument("action", choices=["admit", "release", "status", "correct", "override"])
    ap.add_argument("token", nargs="?")
    ap.add_argument("--provider", required=True, choices=["claude", "codex"])
    ap.add_argument("--agent")
    ap.add_argument("--pid", type=int)
    ap.add_argument("--after-pid", type=int)
    ap.add_argument("--run", help="the Paperclip run id, kept in the run's usage record")
    ap.add_argument("--window", choices=list(quota.WINDOWS))
    ap.add_argument("--points", type=float)
    ap.add_argument("--reason")
    ap.add_argument("--until", help="override: when it ends, as local time YYYY-MM-DDTHH:MM")
    a = ap.parse_args(argv[1:])
    os.makedirs(LEDGER_DIR, mode=0o700, exist_ok=True)
    if a.action == "override":
        if not a.window or a.points is None or not a.until or not a.reason:
            ap.error("override needs --window, --points, --until and --reason")
        import datetime
        until = datetime.datetime.fromisoformat(a.until).astimezone().timestamp()
        if until <= quota.now():
            ap.error("--until is in the past")
        o = quota.override(a.window, a.points, until)
        target = os.path.join(LEDGER_DIR, f"override-{a.provider}.json")
        with open(os.open(target + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(o, f)
        os.replace(target + ".tmp", target)
        fd = os.open(os.path.join(LEDGER_DIR, "corrections.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps({"t": quota.now(), "provider": a.provider, "override": o, "reason": a.reason,
                                "by": os.environ.get("SUDO_USER") or os.environ.get("USER")}) + "\n")
        print(f"{a.provider} {a.window} cap {a.points:g} until {a.until}, then policy/quota.json again")
        return 0
    policy = load(a.provider)
    path = os.path.join(LEDGER_DIR, a.provider + ".json")
    runs_log = os.path.join(LEDGER_DIR, a.provider + "-runs.jsonl")
    if a.action == "release" and a.after_pid:
        # /proc, not kill(0), to see whether the run is alive. While it is, read usage every few minutes and stop
        # the run once studio use reaches a cap. The run's process is sudo, whose real user is still paperclip,
        # so paperclip may signal it, and sudo passes the signal on to the agent CLI.
        every = float(os.environ.get("STUDIO_QUOTA_CHECK", 120))
        next_check, stopped = time.time() + every, False
        while os.path.exists(f"/proc/{a.after_pid}"):
            if not stopped and every > 0 and time.time() >= next_check:
                next_check = time.time() + every
                stopped = check_running(a, path, policy)
            time.sleep(float(os.environ.get("STUDIO_QUOTA_POLL", 5)))
        time.sleep(float(os.environ.get("STUDIO_QUOTA_SETTLE", 10)))  # late usage reports land in this run
    with quota.Ledger(path) as ledger:
        if a.action == "correct":
            if not a.window or a.points is None or not a.reason:
                ap.error("correct needs --window, --points and --reason")
            key, before = quota.correct(ledger, a.window, a.points)
            fd = os.open(os.path.join(LEDGER_DIR, "corrections.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a") as f:
                f.write(json.dumps({"t": quota.now(), "provider": a.provider, "window": a.window, "key": key,
                                    "before": before, "after": a.points, "reason": a.reason,
                                    "by": os.environ.get("SUDO_USER") or os.environ.get("USER")}) + "\n")
            print(f"{a.provider} {a.window} ({key}): studio use {before:g} -> {a.points:g}")
            return 0
        if a.action == "release":
            if not a.token:
                ap.error("release needs a token")
            try:
                r = reading(a.provider)
            except quota.QuotaError as e:
                print(f"studio-quota: {e}; run stays counted until the next reading", file=sys.stderr)
                r = None
            quota.release(ledger, a.token, r, quota.now())
            quota.flush_finished(ledger, runs_log)
            return 0
        try:
            r = reading(a.provider)
        except quota.QuotaError as e:
            print(f"studio-quota: no {a.provider} usage reading ({e}); not starting", file=sys.stderr)
            return 6
        if a.action == "status":
            quota.observe(ledger, r, quota.now())
            print(json.dumps(quota.status(ledger, r, policy)))
            return 0
        if not a.agent or not a.pid:
            ap.error("admit needs --agent and --pid")
        token, reasons = quota.admit(ledger, r, a.agent, a.pid, policy, quota.now(), run=a.run)
        quota.flush_finished(ledger, runs_log)  # runs that admission found finished
    if token is None:
        print(f"studio-quota: {a.provider} cap reached; not starting: " + "; ".join(reasons), file=sys.stderr)
        return 5
    print(token)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
