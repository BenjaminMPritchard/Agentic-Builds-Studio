#!/usr/bin/env python3
"""Claude Code PreToolUse hook. Reads the hook JSON on stdin.

Exit 2 (reason on stderr) blocks the tool call; exit 0 means "no decision".
Best-effort for shell commands: it catches the common ways to break the rules,
and the deny rules, branch protection and CODEOWNERS back it up.
"""
import fnmatch
import json
import os
import re
import shlex
import subprocess
import sys
import urllib.request

LIVE_KEY = re.compile(r"\b(sk|pk|rk)_live_[A-Za-z0-9]+")
PROTECTED = ["CLAUDE.md", ".claude/**", "docs/PLAN.md", "CONSTITUTION.md", ".studio/project.yaml",
             ".studio-allowed-paths"]
NEVER_ALLOWED = ["CONSTITUTION.md", ".studio-allowed-paths"]  # not even a task packet can unlock these
MAIN = r"(main|master)"
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n.*?\n\s*\2(?=\s|$)", re.S)
# Programs that modify their arguments: any protected path among the arguments counts.
WRITERS = {"tee", "rm", "mv", "truncate", "patch", "shred", "unlink", "chmod", "chown", "ln", "install"}
EMAIL_SEND = re.compile(r"paperclipai\s+email\s+(send|reply)|agentmail\S*\s+(send|reply)")
EMAIL_TOOL = re.compile(r"(agentmail|mail).*(send|reply)", re.I)
PAPERCLIP_ADMIN = re.compile(
    r"paperclipai\s+(company\s+(import|delete)|secret|budget|agent\s+(create|update|delete|config|skills:sync)|"
    r"instance|approval\s+(approve|resolve))")
DNS = re.compile(r"\b(nsupdate|flarectl|cloudflared?\s+dns|doctl\s+compute\s+domain|aws\s+route53|gcloud\s+dns)\b")
DROP = re.compile(r"(dropdb\s+(?:\S+\s+)*?(\S+)|DROP\s+DATABASE\s+(?:IF\s+EXISTS\s+)?\"?(\w+))", re.I)
SAFE_DB = re.compile(r"^(mc_|test_mc_).*|.*_e2e$")

# TODO(check): the endpoint and field names below are unverified against the installed Paperclip.
CONFIRMATION_PATH = "/api/issues/{task}/interactions"


def block(reason):
    print(f"BLOCKED by studio guard: {reason}", file=sys.stderr)
    sys.exit(2)


def branch(cwd):
    try:
        r = subprocess.run(["git", "-C", cwd or ".", "rev-parse", "--abbrev-ref", "HEAD"],
                           capture_output=True, text=True, timeout=5)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def repo_root(cwd):
    try:
        r = subprocess.run(["git", "-C", cwd or ".", "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=5)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def allowed_paths(cwd):
    root = repo_root(cwd) or cwd or "."
    paths = [p for p in os.environ.get("STUDIO_ALLOWED_PATHS", "").split(":") if p]
    try:
        with open(os.path.join(root, ".studio-allowed-paths")) as f:
            paths += [ln.strip() for ln in f if ln.strip() and not ln.startswith("#")]
    except OSError:
        pass
    return paths


def rel(path, cwd):
    root = repo_root(cwd) or cwd or "."
    p = os.path.normpath(path if os.path.isabs(path) else os.path.join(cwd or ".", path))
    return os.path.relpath(p, root)


def match(relpath, pattern):
    if pattern.endswith("/**"):
        return relpath == pattern[:-3] or relpath.startswith(pattern[:-2])
    return fnmatch.fnmatch(relpath, pattern)


def check_protected(relpath, cwd):
    for pat in PROTECTED:
        if match(relpath, pat):
            if any(match(relpath, n) for n in NEVER_ALLOWED):
                block(f"{relpath} can only be changed by a human")
            if not any(match(relpath, a) for a in allowed_paths(cwd)):
                block(f"{relpath} is protected; the task packet's allowed-paths must list it")


def check_main_branch(cwd, what):
    b = branch(cwd)
    if b and re.fullmatch(MAIN, b):
        block(f"{what} on '{b}'. Work on a branch agent/<issue>-<slug> in a worktree")


def merge_allowed(seg, cwd):
    """Reason string if this `gh pr merge` is NOT allowed, else None. Only the Director may merge, and only an
    agent PR on a project repo that is open, ready, green and not marked needs-human. Fails closed."""
    director = os.environ.get("STUDIO_DIRECTOR_ID")
    if not director or os.environ.get("PAPERCLIP_AGENT_ID") != director:
        return "only the Director may merge"
    if re.search(r"--admin\b", seg):
        return "merging with --admin (bypassing protection) is human-only"
    try:
        toks = shlex.split(seg)
    except ValueError:
        return "cannot parse the merge command"
    args = toks[toks.index("merge") + 1:]
    repo, num, i = None, None, 0
    while i < len(args):
        if args[i] in ("-R", "--repo") and i + 1 < len(args):
            repo, i = args[i + 1], i + 2
            continue
        if not args[i].startswith("-") and num is None:
            num = args[i]
        i += 1
    if not (num and num.isdigit()):
        return "name the PR by number"
    view = ["gh", "pr", "view", num, "--json", "state,isDraft,headRefName,labels,statusCheckRollup,reviewDecision,files,url"]
    if repo:
        view += ["--repo", repo]
    try:
        r = subprocess.run(view, capture_output=True, text=True, timeout=20, cwd=cwd or None)
        pr = json.loads(r.stdout) if r.returncode == 0 else None
    except Exception:
        pr = None
    if not pr:
        return "could not read the PR to check it"
    if "studio-company" in (repo or "") + pr.get("url", ""):
        return "changes to the Studio's own repo are human-only"
    if pr["state"] != "OPEN" or pr["isDraft"]:
        return "PR is not open and ready"
    if not pr["headRefName"].startswith("agent/"):
        return "only agent/* branches"
    if any(l["name"].lower() in ("needs-human", "needs-board") for l in pr.get("labels", [])):
        return "PR is labelled needs-human"
    if pr.get("reviewDecision") == "CHANGES_REQUESTED":
        return "changes were requested"
    checks = pr.get("statusCheckRollup") or []
    if not checks or any((c.get("conclusion") or c.get("state")) not in ("SUCCESS", "NEUTRAL", "SKIPPED") for c in checks):
        return "checks are not all green"
    for f in pr.get("files", []):
        if any(match(f["path"], pat) for pat in PROTECTED):
            return f"PR touches protected path {f['path']}"
    return None


def confirmation_accepted():
    """True when the current issue has an accepted request_confirmation. Fails closed."""
    base, task, key = (os.environ.get(k) for k in ("PAPERCLIP_API_URL", "PAPERCLIP_TASK_ID", "PAPERCLIP_API_KEY"))
    if not (base and task and key):
        return False
    try:
        req = urllib.request.Request(base.rstrip("/") + CONFIRMATION_PATH.format(task=task),
                                     headers={"Authorization": f"Bearer {key}"})
        data = json.load(urllib.request.urlopen(req, timeout=5))
        items = data.get("interactions", data) if isinstance(data, dict) else data
        latest = [i for i in items if i.get("kind", i.get("type")) == "request_confirmation"]
        return bool(latest) and latest[-1].get("status") == "accepted"
    except Exception:
        return False


def check_bash(cmd, cwd):
    if LIVE_KEY.search(cmd):
        block("live Stripe key in command")
    for seg in re.split(r"&&|\|\||;|\n|\|", cmd):
        s = seg.strip()
        if re.match(r"(?:\S+=\S+\s+)*git\s+(?:-C\s+\S+\s+)?push\b", s):
            if re.search(r"(--force\b|--force-with-lease|--force-if-includes|\s-f\b|\s\+\S)", s):
                block("force push")
            if re.search(rf"(\s|:|/|^){MAIN}(\s|$)", s) or re.search(rf"refs/heads/{MAIN}", s):
                block("push to main/master")
            if not re.search(r"\S+\s+\S+", s.split("push", 1)[1]) and (branch(cwd) or "") in ("main", "master"):
                block("push from main")
        if re.match(r"(?:\S+=\S+\s+)*gh\s+pr\s+merge\b", s):
            why = merge_allowed(s, cwd)
            if why:
                block(f"merge refused: {why}")
        if re.match(r"(?:\S+=\S+\s+)*git\s+(commit|merge|rebase|cherry-pick|reset)\b", s):
            check_main_branch(cwd, "git " + s.split()[1])
        if re.match(r"(?:\S+=\S+\s+)*(make\s+e2e|npx\s+playwright|playwright\s+test)", s):
            block("e2e runs only through /srv/studio/bin/studio-e2e")
    if EMAIL_SEND.search(cmd) and not confirmation_accepted():
        block("email send without an accepted request_confirmation for this draft")
    if PAPERCLIP_ADMIN.search(cmd):
        block("changing Paperclip configuration is outside agent authority")
    if DNS.search(cmd):
        block("DNS changes are human-only")
    for m in DROP.finditer(cmd):
        name = m.group(2) or m.group(3)
        if name and not SAFE_DB.match(name):
            block(f"dropping database '{name}' (only mc_*, test_mc_*, *_e2e allowed)")
    for path in protected_writes(cmd, cwd):
        if any(match(path, n) for n in NEVER_ALLOWED) or not any(match(path, a) for a in allowed_paths(cwd)):
            block(f"command appears to modify protected path {path}")


def protected_of(token, cwd):
    """The PROTECTED pattern a shell token names, or None."""
    t = token.lstrip("<>&0123456789")
    if not t or t.startswith("-"):
        return None
    try:
        r = rel(t, cwd)
    except Exception:
        return None
    return r if any(match(r, p) for p in PROTECTED) else None


def protected_writes(cmd, cwd):
    """Protected paths a command writes to. Reads (cat, grep, head, 2>/dev/null) don't count;
    heredoc bodies are text, not commands."""
    hits = []
    for seg in re.split(r"&&|\|\||;|\n|\|", HEREDOC.sub("", cmd)):
        try:
            toks = shlex.split(seg)
        except ValueError:
            toks = seg.split()
        while toks and re.fullmatch(r"\w+=\S*", toks[0]):
            toks.pop(0)
        if not toks:
            continue
        prog = os.path.basename(toks[0])
        for i, t in enumerate(toks):
            if re.match(r"^\d*>>?\|?&?$", t) and i + 1 < len(toks):  # `> FILE`
                target = toks[i + 1]
            elif re.match(r"^\d*>>?[^&>]", t):                          # `>FILE`
                target = re.sub(r"^\d*>>?", "", t)
            else:
                continue
            p = protected_of(target, cwd)
            if p:
                hits.append(p)
        args = toks[1:]
        writer = prog in WRITERS or (prog in ("sed", "perl") and any(a.startswith("-i") for a in args)) \
            or (prog == "git" and args[:1] and args[0] in ("checkout", "restore", "apply", "rm", "mv"))
        if prog == "cp" and args:
            args = args[-1:]  # only the destination is written
            writer = True
        if writer:
            hits += [p for p in (protected_of(a, cwd) for a in args) if p]
    return hits


def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        sys.exit(0)
    tool, inp, cwd = data.get("tool_name", ""), data.get("tool_input") or {}, data.get("cwd") or os.getcwd()
    if tool == "Bash":
        check_bash(inp.get("command", ""), cwd)
    elif tool in ("Edit", "Write", "NotebookEdit"):
        content = " ".join(str(inp.get(k, "")) for k in ("content", "new_string", "new_source"))
        if LIVE_KEY.search(content):
            block("live Stripe key in file content")
        path = inp.get("file_path") or inp.get("notebook_path") or ""
        if path:
            check_protected(rel(path, cwd), cwd)
            check_main_branch(os.path.dirname(os.path.abspath(path if os.path.isabs(path) else os.path.join(cwd, path))), "editing files")
    elif EMAIL_TOOL.search(tool) and tool.startswith("mcp__"):
        if not confirmation_accepted():
            block(f"{tool}: email send without an accepted request_confirmation")
    sys.exit(0)


if __name__ == "__main__":
    main()
