#!/usr/bin/env bash
# git credential helper for confined agent runs (set by agent-exec for https://github.com): answers `get`
# with a current App token from agent-gh-token; `store` and `erase` do nothing.
set -euo pipefail
HERE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
[ "${1:-}" = get ] || exit 0
cat >/dev/null
T="$("$HERE/agent-gh-token")"
printf 'username=x-access-token\npassword=%s\n' "$T"
