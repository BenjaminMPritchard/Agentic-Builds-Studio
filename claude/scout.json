{
  "maxEffortLevel": "medium",
  "permissions": {
    "deny": [
      "Agent",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)",
      "Bash(make e2e*)",
      "Bash(npx playwright*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh api -X*)",
      "Bash(gh api --method*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/srv/studio/bin/guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/srv/studio/bin/guard"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/srv/studio/bin/guard"
          }
        ]
      }
    ]
  }
}
